**/__pycache__/
/vvv
*.ini
*.log

# Config, logs and caches are JSON, and there are far more of those than there are
# JSON files we mean to keep - so the rule is exclude-then-name-the-exceptions. A
# committed .json needs a negation below, in the same commit that adds it: forgetting
# one is silent, green locally and missing on a clean checkout.
*.json

# The parity gate's committed master snapshot - see docs/compatibility-3.0.md
!tests/fixtures/parity_baseline_master.json

# The theme payload the JavaScript tests read. Committed on purpose: it is the only
# thing tying tests/js/ to what Python actually builds.
!tests/fixtures/theme_payload.json

# The defaults a new install writes, frozen outside the schema. The outside witness
# that keeps config_schema honest, since the store now reads its defaults from it.
!tests/fixtures/config_defaults.json

# Every config name we have ever written. Frozen outside the schema on purpose: reading
# it from the schema would delete the assertion along with the alias it guards.
!tests/fixtures/config_legacy_names.json

# The theme the render smoke test drives. Its manifest declares the contract and the
# windows, so without this the harness is a contract 1 theme and the test asserts nothing.
!tests/fixtures/theme-harness/*.json

# Declares the frontend test runner, beside the tests it runs. Named in full: a bare
# package.json would un-ignore one anywhere in the tree.
!tests/js/package.json

# DOF and libdmdutil, fetched by scripts/ at build time and never committed.
third_party/

# PyInstaller build directories
build/
dist/

# Per-developer assistant and editor config, never the project's
.claude/
.codex
.vscode/
.idea/
*.local.md

# Virtual environments
.venv/
venv/
.python-version

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# macOS folder metadata
.DS_Store
